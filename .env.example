# Copy to .env (in the folder you run clipagent from) or ~/.config/clipagent/.env
# Real environment variables always take precedence over this file.

# --- Claude: highlight detection, virality scoring, B-roll ideas (strongly recommended)
ANTHROPIC_API_KEY=

# --- B-roll stock footage (free key: https://www.pexels.com/api/)
PEXELS_API_KEY=

# --- YouTube downloads from servers / datacenter IPs
# YTDLP_COOKIES=/path/to/cookies.txt
# YTDLP_COOKIES_FROM_BROWSER=chrome

# --- Auto-posting -------------------------------------------------------------
# YouTube Shorts: OAuth client from Google Cloud Console (Desktop app type), then
#   run `clipagent auth youtube` once.
# YOUTUBE_CLIENT_SECRETS=/path/to/client_secret.json

# TikTok: user access token from your TikTok developer app (scope video.upload,
#   plus video.publish for direct posting).
# TIKTOK_ACCESS_TOKEN=

# Instagram Reels: Instagram professional account connected to a Facebook app.
# IG_USER_ID=
# IG_ACCESS_TOKEN=
# GRAPH_API_VERSION=v23.0

# --- Web UI
# CLIPAGENT_DATA_DIR=./clipagent-data
# CLIPAGENT_WEB_TOKEN=          # if set, the web UI asks for this password
