# Copy to .env (in the folder you run clipagent from) or ~/.config/clipagent/.env
# Real environment variables always take precedence over this file.

# --- AI model for highlight detection, virality scoring, titles and B-roll ideas.
# Set ONE of these (strongly recommended). If both are set, Claude is used
# unless you pass --llm-provider gemini.
# Claude key from https://console.anthropic.com
ANTHROPIC_API_KEY=
# Gemini key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional Gemini model override, e.g. gemini-2.5-pro
# GEMINI_MODEL=gemini-flash-latest

# --- B-roll stock footage (free key: https://www.pexels.com/api/)
PEXELS_API_KEY=

# --- YouTube downloads from servers / datacenter IPs
# YTDLP_COOKIES=/path/to/cookies.txt
# YTDLP_COOKIES_FROM_BROWSER=chrome

# --- Web UI
# CLIPAGENT_DATA_DIR=./clipagent-data
# CLIPAGENT_WEB_TOKEN=          # if set, the web UI asks for this password
